# Environment variables for Docker development
# PostgreSQL credentials
POSTGRES_DB=ticketdesk
POSTGRES_USER=ticketdesk_user
POSTGRES_PASSWORD=ticketdesk_pass
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django secret key (dev only)
DJANGO_SECRET_KEY=django-insecure-dev-ticketdesk-secret-key-123456

# Django allowed hosts (comma separated)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

